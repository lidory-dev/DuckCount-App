          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher"
          }
        }
      }
    },
    "Send request" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer la demande"
          }
        }
      }
    },
    "The contact could not be deleted, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contact n’a pas pu être supprimé, réessayez."
          }
        }
      }
    },
    "The contact request could not be answered, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de répondre à la demande de contact, réessayez."
          }
        }
      }
    },
    "The contact request could not be sent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande de contact n’a pas pu être envoyée."
          }
        }
      }
    },
    "The safety number could not be shown." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le numéro de sécurité n’a pas pu être affiché."
          }
        }
      }
    },
    "The server is unreachable, please try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur est injoignable, réessayez plus tard."
          }
        }
      }
    },
    "The server took too long to answer, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a mis trop de temps à répondre, réessayez."
          }
        }
      }
    },
    "Their request will be declined and they won’t be able to send you contact requests any more. They won’t be told." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa demande sera refusée et cette personne ne pourra plus vous envoyer de demande de contact. Elle n’en sera pas informée."
          }
        }
      }
    },
    "They will be able to send you contact requests again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne pourra de nouveau vous envoyer des demandes de contact."
          }
        }
      }
    },
    "They will be removed from your contacts and won’t be able to send you contact requests or expenses any more. Groups you share stay as they are. They won’t be told you blocked them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne sera retirée de vos contacts et ne pourra plus vous envoyer ni demande de contact ni dépense. Les groupes que vous partagez restent inchangés. Elle ne sera pas informée du blocage."
          }
        }
      }
    },
    "This contact could not be blocked, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contact n’a pas pu être bloqué, réessayez."
          }
        }
      }
    },
    "This contact request no longer exists." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande de contact n’existe plus."
          }
        }
      }
    },
    "This person is no longer one of your contacts" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne ne fait plus partie de vos contacts"
          }
        }
      }
    },
    "This user is already one of your contacts." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet utilisateur fait déjà partie de vos contacts."
          }
        }
      }
    },
    "This username is not valid." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce nom d’utilisateur n’est pas valide."
          }
        }
      }
    },
    "To verify the end-to-end encryption between you and this contact, compare the numbers above with the ones on their phone, in person or on a call you trust." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vérifier le chiffrement de bout en bout entre vous et ce contact, comparez les chiffres ci-dessus avec ceux affichés sur son téléphone, en personne ou lors d’un appel de confiance."
          }
        }
      }
    },
    "Too many attempts, please try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives, réessayez plus tard."
          }
        }
      }
    },
    "Unblock" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquer"
          }
        }
      }
    },
    "Unblock this user?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquer cet utilisateur ?"
          }
        }
      }
    },
