    "Verified" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifié"
          }
        }
      }
    },
    "Verify safety number" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier le numéro de sécurité"
          }
        }
      }
    },
    "You already sent this user a contact request." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de contact est déjà en attente pour cet utilisateur."
          }
        }
      }
    },
    "You blocked this user. Unblock them to send a request." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez bloqué cet utilisateur. Débloquez-le pour lui envoyer une demande."
          }
        }
      }
    },
    "You can’t add yourself as a contact." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de s’ajouter soi-même comme contact."
          }
        }
      }
    },
    "You don’t have any contacts yet" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun contact pour le moment"
          }
        }
      }
    },
    "You had already accepted this request, so this person was added to your contacts." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande avait déjà été acceptée, cette personne a donc été ajoutée à vos contacts."
          }
        }
      }
    },
    "Your contacts need a username to add you, and you need one to add them.\n\nReserve yours to start building your contact list." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos contacts ont besoin de votre nom d’utilisateur pour vous ajouter, et vous avez besoin du leur pour les ajouter.\n\nRéservez le vôtre pour commencer à constituer votre liste de contacts."
          }
        }
      }
    },
    "Your safety number with this contact has changed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre numéro de sécurité avec ce contact a changé"
          }
        }
      }
    },
    "Your safety number with this user has changed, so the request was not accepted." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre numéro de sécurité avec cet utilisateur a changé, la demande n’a pas été acceptée."
          }
        }
      }
    },
    "Your safety number with this user has changed, so the request was not sent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre numéro de sécurité avec cet utilisateur a changé, la demande n’a pas été envoyée."
          }
        }
      }
    }
  },
  "version" : "1.0"
