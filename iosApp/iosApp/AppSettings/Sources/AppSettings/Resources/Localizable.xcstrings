        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire la licence"
          }
        }
      }
    },
    "Required" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obligatoire"
          }
        }
      }
    },
    "Reserve" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réserver"
          }
        }
      }
    },
    "Reserve the username your contacts will use to add you.\n\nOnly a fingerprint of it reaches our servers, so we never learn the username itself — only somebody who already knows it can find you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réservez le nom d’utilisateur que vos contacts utiliseront pour vous ajouter.\n\nSeule une empreinte de celui-ci parvient à nos serveurs. Nous ne connaissons donc jamais le nom d’utilisateur lui-même, seule une personne qui le connaît déjà peut vous trouver."
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer"
          }
        }
      }
    },
    "Search" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages"
          }
        }
      }
    },
    "Source code" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code source"
          }
        }
      }
    },
    "Terms of use" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions d’utilisation"
          }
        }
      }
    },
    "The passwords do not match." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe ne correspondent pas."
          }
        }
      }
    },
    "The server is unreachable, please try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur est injoignable, réessayez plus tard."
          }
        }
      }
    },
    "The server took too long to answer, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a mis trop de temps à répondre, réessayez."
          }
        }
      }
    },
    "The server’s answer never arrived, so your account may already be deleted. Check your connection, then try again to find out." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse du serveur n’est pas arrivée, votre compte est donc peut-être déjà supprimé. Vérifiez votre connexion, puis réessayez pour le savoir."
          }
        }
      }
    },
    "The server’s answer never arrived, so your password may already have been changed. If your current password is refused when you try again, or you’re asked to log in again, use your new password." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse du serveur n’est pas arrivée, votre mot de passe a donc peut-être déjà été modifié. Si votre mot de passe actuel est refusé lorsque vous réessayez, ou s’il vous est demandé de vous reconnecter, utilisez votre nouveau mot de passe."
          }
        }
      }
    },
    "The username could not be reserved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’utilisateur n’a pas pu être réservé."
          }
        }
      }
    },
    "This password has been leaked, please choose another one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe est compromis, choisissez-en un autre."
          }
        }
      }
    },
    "This username cannot be used." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce nom d’utilisateur ne peut pas être utilisé."
          }
        }
      }
    },
    "This username is already taken." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce nom d’utilisateur est déjà pris."
          }
        }
      }
    },
    "Too many attempts, please try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives, réessayez plus tard."
          }
        }
      }
    },
    "Username" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom d’utilisateur"
          }
        }
      }
    },
    "Username too long (%lld/%lld)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom d’utilisateur trop long (%lld/%lld)"
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Visible only to your contacts and group members.\n\nEverything is end-to-end encrypted, which means we can’t see your profile — only the people you choose to share it with." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visible uniquement par vos contacts et les membres de vos groupes.\n\nTout est chiffré de bout en bout, nous ne pouvons pas voir votre profil. Seules les personnes avec qui vous choisissez de le partager y ont accès."
          }
        }
      }
    },
    "Website" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site web"
          }
        }
      }
    },
    "Your account changed on another device, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte a changé sur un autre appareil, réessayez."
          }
        }
      }
    },
    "Your account could not be deleted." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte n’a pas pu être supprimé."
          }
        }
      }
    },
    "Your full name is too long." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom complet est trop long."
          }
        }
      }
    },
    "Your password can’t be only spaces." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe ne peut pas être composé uniquement d’espaces."
          }
        }
      }
    },
    "Your password could not be changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe n’a pas pu être modifié."
          }
        }
      }
    },
    "Your password has been changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe a été modifié."
          }
        }
      }
    },
    "Your password must have at least %lld characters." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe doit contenir au moins %lld caractères."
          }
        }
      }
    },
    "Your profile changed on another device, please try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil a changé sur un autre appareil, réessayez."
          }
        }
      }
    },
    "Your profile could not be saved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil n’a pas pu être enregistré."
          }
        }
      }
    },
    "© 2026 Lidory SAS. All rights reserved.\nDuckCount® and Lidory® are trademarks of Lidory SAS." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "© 2026 Lidory SAS. Tous droits réservés.\nDuckCount® et Lidory® sont des marques déposées de Lidory SAS."
          }
        }
      }
    },
    "🐤 Quack!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🐤 Coin-coin !"
          }
        }
      }
    }
  },
